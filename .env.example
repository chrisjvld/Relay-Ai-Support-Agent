# Required for live mode (chat, query embeddings and `npm run seed`).
OPENAI_API_KEY=

# Optional model overrides (defaults shown).
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Demo playback: scripted, tool-using replies with no OpenAI calls.
# 1 = always on, 0 = never. Unset = on automatically when OPENAI_API_KEY is empty.
DEMO_MODE=
